<IfModule mod_rewrite.c>
    RewriteEngine On

    # ถ้าเรียกไฟล์หรือโฟลเดอร์ที่มีอยู่จริง (เช่น products.html, js, css) ให้เปิดตรงๆ
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # ส่ง Request อื่นๆ ทั้งหมดมาที่ index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>
